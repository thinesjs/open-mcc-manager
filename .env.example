COMPOSE_PROJECT_NAME=open-mcc
DEV_DB_PORT=25432
TEST_DB_PORT=25433
SERVER_PORT=25174
WEB_PORT=25173
SERVER_ORIGIN=http://localhost:25174
DATABASE_URL=postgres://postgres:postgres@localhost:25432/open_mcc_manager
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:25433/postgres
PORT=25174
POSTGRES_PASSWORD=postgres
# Generate with: openssl rand -base64 32 (minimum 16 characters)
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:25174
# Generated by scripts/install.sh, or: docker run --rm <server-image> server.mjs --generate-sealbox-key k1
SEALBOX_KEYS=k1:REPLACE_PUBLIC:REPLACE_PRIVATE
ALLOWED_ORIGINS=http://localhost:25173
# Notifications only reach public https addresses. To reach a push server on
# your own network, name it below, or name its address or range. Ports are not
# part of a name, and a name matches only itself, never anything under it.
# NOTIFICATION_ALLOWED_HOSTS=gotify.internal,push.example.com
# NOTIFICATION_ALLOWED_ADDRESSES=192.168.4.0/24,10.1.2.3
# Allows plain http, but only to a host named above or an address inside a
# range named above. A name is never resolved to decide this, so a range alone
# cannot authorise http to a HOSTNAME - name the host itself for that.
# NOTIFICATION_ALLOW_HTTP=true
# Microsoft Teams destinations accept a Power Automate workflow address on the
# commercial cloud. Name another cloud's address ending here if yours differs.
# NOTIFICATION_TEAMS_HOSTS=environment.api.powerplatform.us

# Sign-in through your own identity provider. Left empty, the sign-in page is
# unchanged and no such route is served. Set all three together and register
# BETTER_AUTH_URL + /api/auth/callback/oidc as the redirect address there.
# Only someone already invited here can sign in this way: the provider says who
# they are, this deployment still decides whether they are a member. Whoever you
# point this at becomes the authority on your members' email addresses, and one
# that does not confirm them is refused.
# OIDC_ISSUER_URL=https://id.example.com/application/o/open-mcc
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Goes on the button, so use the name your people know it by.
# OIDC_NAME=Acme ID

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# Written by scripts/self-host.sh and appended to .env by scripts/install.sh, so
# the dashboard can offer this machine as a host without anyone typing an
# address or a fingerprint. Left empty, no such offer is made. Do not fill these
# in by hand: the address has to be one a container proved it can reach, and the
# sealed private key only opens with this deployment's own SEALBOX_KEYS.
SELF_HOST_PORT=
# SELF_HOST_NAME=
# SELF_HOST_HOSTNAME=
# SELF_HOST_USERNAME=
# SELF_HOST_FINGERPRINT=
# SELF_HOST_PUBLIC_KEY=
# SELF_HOST_PRIVATE_KEY_SEALED=
# SELF_HOST_PRIVATE_KEY_ID=
# SELF_HOST_REACH=
# SELF_HOST_SYSTEMD=
# SELF_HOST_LINGER=
