DATABASE_URL=postgres://postgres:postgres@localhost:5432/open_mcc_manager
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/postgres
PORT=3000
# Generate with: openssl rand -base64 32 (minimum 16 characters)
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000
# Generate with: pnpm --filter @open-mcc/server keys:generate k1
SEALBOX_KEYS=k1:REPLACE_PUBLIC:REPLACE_PRIVATE
ALLOWED_ORIGINS=http://localhost:5173
INSTANCES_ROOT=/srv/open-mcc
