{
	"name": "@open-mcc/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:migrate": "tsx src/migrate.ts",
		"db:codegen": "kysely-codegen --dialect postgres --include-pattern \"public.*\" --out-file src/generated/database.ts"
	},
	"dependencies": {
		"kysely": "^0.29.5",
		"pg": "^8.23.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@open-mcc/config": "workspace:*",
		"@types/pg": "^8.23.1",
		"kysely-codegen": "^0.20.0",
		"tsx": "^4.23.13"
	}
}
