COMPOSE_PROJECT_NAME=open-mcc
DEV_DB_PORT=25432
TEST_DB_PORT=25433
SERVER_PORT=25174
WEB_PORT=25173
SERVER_ORIGIN=http://localhost:25174
DATABASE_URL=postgres://postgres:postgres@localhost:25432/open_mcc_manager
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:25433/postgres
PORT=25174
POSTGRES_PASSWORD=postgres
# Generate with: openssl rand -base64 32 (minimum 16 characters)
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:25174
# Generated by scripts/install.sh, or: docker run --rm <server-image> server.mjs --generate-sealbox-key k1
SEALBOX_KEYS=k1:REPLACE_PUBLIC:REPLACE_PRIVATE
ALLOWED_ORIGINS=http://localhost:25173
# Notifications only reach public https addresses. To reach a push server on
# your own network, name it below, or name its address or range. Ports are not
# part of a name, and a name matches only itself, never anything under it.
# NOTIFICATION_ALLOWED_HOSTS=gotify.internal,push.example.com
# NOTIFICATION_ALLOWED_ADDRESSES=192.168.4.0/24,10.1.2.3
# Allows plain http, but only to a host or address named above. It never opens
# an address on its own.
# NOTIFICATION_ALLOW_HTTP=true
